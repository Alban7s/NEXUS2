# =============================================================================
# NEXUS configuration. Copy to `.env` (never commit `.env`).
# Every value is optional; NEXUS runs with none of them and shows
# "Not configured" for the integrations you have not set up.
# =============================================================================

# --- Security of NEXUS itself -------------------------------------------------
# REQUIRED before exposing NEXUS beyond your own machine. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
NEXUS_API_KEY=
# Comma-separated browser origins allowed by CORS. Leave empty for same-origin.
NEXUS_CORS_ORIGINS=

# --- Storage -------------------------------------------------------------------
NEXUS_WORK_DIR=./nexus-jobs
NEXUS_DATA_DIR=./nexus-data

# --- ZIP intake limits ---------------------------------------------------------
NEXUS_MAX_UPLOAD_MB=100
NEXUS_MAX_UNCOMPRESSED_MB=500
NEXUS_MAX_SINGLE_FILE_MB=100
NEXUS_MAX_FILES=10000
NEXUS_MAX_COMPRESSION_RATIO=100

# --- Build ---------------------------------------------------------------------
# true = npm lifecycle scripts (postinstall...) of uploaded code do NOT run.
NEXUS_NPM_IGNORE_SCRIPTS=true
NEXUS_RUN_TESTS=true
NEXUS_BUILD_MEMORY_MB=2048
NEXUS_MAX_CONCURRENT_JOBS=1

# --- Docker --------------------------------------------------------------------
# Normally leave empty: NEXUS auto-detects Docker Desktop / the Linux socket.
# Windows Docker Desktop:  DOCKER_HOST=npipe:////./pipe/dockerDesktopLinuxEngine
# Linux:                   DOCKER_HOST=unix:///var/run/docker.sock
DOCKER_HOST=

# --- Local preview -------------------------------------------------------------
NEXUS_PUBLIC_HOST=localhost
# 127.0.0.1 = only this machine. Use 0.0.0.0 on EC2 only behind a locked-down SG.
NEXUS_PREVIEW_BIND=127.0.0.1

# --- Trivy ---------------------------------------------------------------------
TRIVY_ENABLED=true
# Fail the pipeline at/above this severity: CRITICAL | HIGH | MEDIUM | LOW | NONE
TRIVY_FAIL_ON_SEVERITY=CRITICAL
TRIVY_IGNORE_UNFIXED=false

# --- Registry (choose ONE) -----------------------------------------------------
# Amazon ECR (credentials come from the normal AWS chain / instance role):
ECR_REPOSITORY_PREFIX=
AWS_REGION=ap-southeast-2
# ...or Docker Hub / any registry:
REGISTRY_URL=
REGISTRY_USERNAME=
REGISTRY_PASSWORD=

# --- Kubernetes ----------------------------------------------------------------
K8S_NAMESPACE=default
# registry = pull from the registry above. minikube = `minikube image load` (no registry needed).
K8S_IMAGE_SOURCE=registry
K8S_SERVICE_TYPE=ClusterIP
K8S_ROLLOUT_TIMEOUT=120
INGRESS_DOMAIN=
INGRESS_CLASS=nginx

# --- Monitoring ----------------------------------------------------------------
PROMETHEUS_URL=http://localhost:9090
GRAFANA_URL=http://localhost:3000

# --- GitHub -> Jenkins (administrator-managed, no per-user login) ---------------
GITHUB_REPO_URL=
GITHUB_BRANCH=main
# Secret you also paste into the GitHub webhook settings.
GITHUB_WEBHOOK_SECRET=
JENKINS_URL=
JENKINS_USER=
JENKINS_API_TOKEN=
JENKINS_JOB=nexus-github-deploy

# --- Argo CD / GitOps (optional) -----------------------------------------------
ARGOCD_URL=
ARGOCD_TOKEN=
ARGOCD_VERIFY_TLS=true
GIT_REPO_URL=
GIT_BRANCH=main
GIT_MANIFESTS_PATH=apps
# Token for pushing manifests. Used through an HTTP header, never put in the URL.
GIT_TOKEN=
GIT_USER_NAME=nexus-bot
GIT_USER_EMAIL=nexus-bot@local

# --- Optional read-only GitHub Actions feed ------------------------------------
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_TOKEN=
